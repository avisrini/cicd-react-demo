# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# production
/dist

# misc
.DS_Store

# local env files
# Vite inlines any VITE_-prefixed variable into the public client bundle,
# so never commit real values here. Keep .env.example for documentation.
.env
.env.*
!.env.example

npm-debug.log*
yarn-debug.log*
yarn-error.log*
